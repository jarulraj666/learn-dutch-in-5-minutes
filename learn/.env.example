# ---- Shared ----
# Postgres used by both the Next.js app (Auth.js adapter) and the FastAPI backend.
DATABASE_URL=postgresql://learn:learn@localhost:55432/learn
# Set to "false" for a local Postgres without TLS.
DATABASE_SSL=false

# Comma-separated emails promoted to admin on sign-in.
ADMIN_EMAILS=

# ---- Frontend (learn/frontend/.env.local) ----
AUTH_SECRET=change-me-run-npx-auth-secret
NEXTAUTH_URL=http://localhost:3001
LEARN_API_URL=http://localhost:8001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, enabled only when both values are present.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Backend (learn/.env) ----
LEARN_ALLOWED_ORIGINS=http://localhost:3001
LEARN_COMPLETION_PERCENT=90
LEARN_CERTIFICATE_PASS_PERCENT=70

# Mollie payments (premium exam access). Test keys start with "test_".
MOLLIE_API_KEY=
# Must be a publicly reachable URL so Mollie can call POST /api/billing/webhook/mollie.
API_BASE_URL=http://localhost:8001

# Stripe payments (alternative to Mollie). Test keys start with "sk_test_".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Which provider /api/billing/checkout uses: "mollie" or "stripe".
PAYMENT_PROVIDER=stripe
