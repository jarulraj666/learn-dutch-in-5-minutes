DB_PATH=db/content.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_IMAGE_MODEL=x/z-image-turbo
VISUAL_IMAGE_FORMAT=png
CHANNEL_TIMEZONE=Europe/Amsterdam
OUTPUT_DIR=output
VIDEO_ARCHIVE_DIR=output/archive
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_PATH=output/youtube_token.json

# TTS Configuration
# Options: gemini, elevenlabs
TTS_PROVIDER=gemini
TTS_FALLBACK_PROVIDER=gemini

# Gemini API keys
GEMINI_API_KEY=
GEMINI_TTS_API_KEY=

# ElevenLabs API key (if using elevenlabs provider)
ELEVENLABS_API_KEY=
# ElevenLabs speech speed (valid range 0.70-1.20, recommended 0.70-0.85 for learner-friendly pacing)
ELEVENLABS_SPEED=0.75
