{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Episode",
  "type": "object",
  "required": [
    "topic_id",
    "topic_title",
    "language",
    "dialogue",
    "quiz",
    "grammar_notes"
  ],
  "properties": {
    "topic_id": {"type": "string"},
    "topic_title": {"type": "string"},
    "language": {"type": "string"},
    "dialogue": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["speaker", "line"],
        "properties": {
          "speaker": {"type": "string"},
          "line": {"type": "string"}
        }
      }
    },
    "key_phrases": {
      "type": "array",
      "items": {"type": "string"}
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nl", "en"],
        "properties": {
          "nl": {"type": "string"},
          "en": {"type": "string"}
        }
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["question", "type", "answer"],
        "properties": {
          "question": {"type": "string"},
          "type": {"type": "string"},
          "choices": {
            "type": "array",
            "items": {"type": "string"}
          },
          "answer": {"type": "string"},
          "explanation": {"type": "string"}
        }
      }
    },
    "grammar_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "explanation", "examples"],
        "properties": {
          "title": {"type": "string"},
          "explanation": {"type": "string"},
          "examples": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
