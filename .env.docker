# Docker Environment Configuration
# Copy this to .env and set your values

# TTS Configuration
TTS_PROVIDER=kokoro
LANGUAGE=nl

# Database
DB_PATH=db/content.db

# Output directories
OUTPUT_DIR=output
VIDEO_OUTPUT_DIR=output/videos
VIDEO_ARCHIVE_DIR=output/archive

# Ollama Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_IMAGE_MODEL=x/flux2-klein:4b

# Timezone
CHANNEL_TIMEZONE=Europe/Amsterdam

# Google API Keys (Optional - for Gemini TTS and YouTube upload)
GEMINI_API_KEY=
YOUTUBE_CLIENT_SECRETS=

# Speech Configuration
SPEECH_RATE_WPM=88
